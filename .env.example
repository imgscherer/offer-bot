# Copy to .env and fill in. Never commit .env.

NICHE=beauty

# Affiliate
SHOPEE_AFFILIATE_ID=
AMAZON_AFFILIATE_TAG=

# Shopee Open API (GraphQL) — opcional, só preencher depois que a Shopee
# aprovar o acesso (pedido feito via affiliate.shopee.com.br/open_api).
# Vazio = ShopeeFetcher não roda, sem quebrar o resto do pipeline.
SHOPEE_OPEN_API_APP_ID=
SHOPEE_OPEN_API_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# Instagram (Meta Graph API)
IG_USER_ID=
IG_ACCESS_TOKEN=

# WhatsApp (Meta Cloud API)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Tuning
MIN_DISCOUNT_PCT=30
MAX_OFFERS_PER_RUN=5
